{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "homespec.schema.json",
 "title": "Home Design Spec",
 "type": "object",
 "required": [
  "meta",
  "site",
  "storeys"
 ],
 "additionalProperties": false,
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "name"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "style": {
     "type": "string",
     "enum": [
      "modern-minimal"
     ],
     "default": "modern-minimal"
    },
    "views": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "type": "string",
        "enum": [
         "exterior_front",
         "exterior_aerial",
         "room"
        ]
       },
       "room_id": {
        "type": "string"
       }
      },
      "if": {
       "properties": {
        "kind": {
         "const": "room"
        }
       }
      },
      "then": {
       "required": [
        "name",
        "kind",
        "room_id"
       ]
      }
     }
    }
   }
  },
  "site": {
   "type": "object",
   "required": [
    "plot_width_mm",
    "plot_depth_mm"
   ],
   "additionalProperties": false,
   "properties": {
    "plot_width_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "plot_depth_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "context": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "neighbours": {
       "type": "boolean",
       "default": true,
       "description": "Build neighbouring party-wall massing flanking the plot. When absent, neighbours are built only when plot_width_mm <= 6000 (the sandwiched-urban-lot case)."
      },
      "street_depth_mm": {
       "type": "number",
       "exclusiveMinimum": 0,
       "default": 6000,
       "description": "Depth of the street strip modelled south of the plot."
      }
     }
    },
    "wall_alignment": {
     "type": "string",
     "enum": [
      "centre",
      "inside"
     ],
     "default": "centre",
     "description": "How exterior walls sit relative to the room edge: 'centre' straddles it (today's geometry); 'inside' lies wholly on the room side so the outer face lands on the plot line."
    }
   }
  },
  "storeys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "level",
     "height_mm",
     "rooms"
    ],
    "additionalProperties": false,
    "properties": {
     "level": {
      "type": "integer",
      "minimum": 0
     },
     "name": {
      "type": "string"
     },
     "height_mm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 3000
     },
     "roof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "type": {
        "type": "string",
        "enum": [
         "flat",
         "gable",
         "shed"
        ]
       },
       "pitch_deg": {
        "type": "number",
        "minimum": 0,
        "maximum": 60,
        "default": 20
       },
       "overhang_mm": {
        "type": "number",
        "minimum": 0,
        "default": 300
       },
       "rect": {
        "type": "object",
        "required": [
         "x",
         "y",
         "w",
         "d"
        ],
        "additionalProperties": false,
        "properties": {
         "x": {
          "type": "number",
          "minimum": 0
         },
         "y": {
          "type": "number",
          "minimum": 0
         },
         "w": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "d": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       },
       "voids": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "x",
          "y",
          "w",
          "d"
         ],
         "additionalProperties": false,
         "properties": {
          "x": {
           "type": "number",
           "minimum": 0
          },
          "y": {
           "type": "number",
           "minimum": 0
          },
          "w": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "d": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       }
      }
     },
     "stairs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "room": {
        "type": "string"
       },
       "direction": {
        "type": "string",
        "enum": [
         "up",
         "down",
         "up_and_down"
        ],
        "default": "up"
       },
       "mode": {
        "type": "string",
        "enum": [
         "auto",
         "straight",
         "u_return",
         "none"
        ],
        "default": "auto"
       }
      }
     },
     "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "id",
        "type"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "name": {
         "type": "string",
         "minLength": 1,
         "description": "Optional human-readable room label, e.g. 'Master bedroom'. Plan labels and the PDF schedule use name when present, else id."
        },
        "type": {
         "type": "string",
         "enum": [
          "bedroom",
          "bathroom",
          "kitchen",
          "living",
          "dining",
          "hall",
          "stairwell",
          "garage",
          "balcony",
          "office",
          "storage",
          "elevator"
         ]
        },
        "rect": {
         "type": "object",
         "required": [
          "x",
          "y",
          "w",
          "d"
         ],
         "additionalProperties": false,
         "properties": {
          "x": {
           "type": "number",
           "minimum": 0
          },
          "y": {
           "type": "number",
           "minimum": 0
          },
          "w": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "d": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        },
        "relative": {
         "type": "object",
         "required": [
          "adjacent_to",
          "side",
          "w",
          "d"
         ],
         "additionalProperties": false,
         "properties": {
          "adjacent_to": {
           "type": "string"
          },
          "side": {
           "type": "string",
           "enum": [
            "north",
            "south",
            "east",
            "west"
           ]
          },
          "w": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "d": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       },
       "oneOf": [
        {
         "required": [
          "rect"
         ]
        },
        {
         "required": [
          "relative"
         ]
        }
       ]
      }
     },
     "openings": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "type",
        "between"
       ],
       "additionalProperties": false,
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "door",
          "window"
         ]
        },
        "between": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "string"
         }
        },
        "side": {
         "type": "string",
         "enum": [
          "north",
          "south",
          "east",
          "west"
         ],
         "description": "Only meaningful when one 'between' endpoint is 'exterior'; north=min-y, south=max-y, west=min-x, east=max-x."
        },
        "width_mm": {
         "type": "number",
         "exclusiveMinimum": 0,
         "default": 900
        },
        "sill_mm": {
         "type": "number",
         "minimum": 0,
         "default": 0
        },
        "head_mm": {
         "type": "number",
         "exclusiveMinimum": 0,
         "default": 2100
        },
        "align": {
         "type": "string",
         "enum": [
          "center",
          "start",
          "end"
         ],
         "default": "center",
         "description": "Where along the wall the opening sits: center, start (wall segment start), or end."
        },
        "offset_mm": {
         "type": "number",
         "minimum": 0,
         "description": "Explicit distance from the wall segment start; overrides align entirely."
        }
       }
      }
     }
    }
   }
  }
 }
}